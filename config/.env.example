MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
SALTROUND=10
PORT=3000
NODE_ENV=development
ENV=DEV
CORS_ORIGINS=http://localhost:4200,https://ziadal3tar.github.io/chat-fe,https://ziadal3tar.github.io
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
MESSAGE_RATE_LIMIT=60
CHAT_READ_RATE_LIMIT=120
SEARCH_RATE_LIMIT=30
MAX_UPLOAD_SIZE_MB=50
PROFILE_IMAGE_MAX_SIZE_MB=5
MESSAGE_MAX_LENGTH=5000
